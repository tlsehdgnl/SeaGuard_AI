# Local development uses the Vite /api proxy if this is empty.
# On Vercel set this in the frontend project's Environment Variables.
# Use the backend's stable production domain, with no trailing slash or /api suffix.
VITE_API_BASE_URL=
# Kakao Maps JavaScript key (public by design; restricted to domains registered under 플랫폼 > Web)
VITE_KAKAO_JS_KEY=
