# Copy to backend/.env.local (gitignored). Never put actual secrets in this template.
# Load priority: process environment > .env.local > .env. On Vercel set server environment variables.
# OpenAI GPT-6 Astra: only OPENAI_API_KEY is required.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Astra has no temperature; it uses low|medium|high (none unsupported). Use "off" for non-reasoning providers.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Alternative OpenAI-compatible provider (used only when OPENAI_API_KEY is empty).
LLM_API_KEY=
# Full HTTPS chat-completions compatible endpoint; keys stay in backend only.
LLM_API_URL=
LLM_MODEL=

# Administrator secret: configure only on the backend; never use VITE_ variables.
ADMIN_TOKEN=
# Required on Vercel. Local development defaults to ~/.seaguard/trails.sqlite3.
TRAIL_DATABASE_URL=
TRAIL_DB_PATH=
# Enable only when the existing seaguard schema has been provisioned.
SEAGUARD_PRIVATE_SCHEMA=0
# 바다낚시지수 (data.go.kr 15142486): use the "Decoding" key — the server URL-encodes it.
FISHING_API_KEY=

# GLAB Supabase: server-only, never expose the secret key in VITE_* variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Comma-separated allowed frontend origins for account mutations.
ACCOUNT_ORIGINS=https://departner-donghae.vercel.app,https://seaguard-web.vercel.app
