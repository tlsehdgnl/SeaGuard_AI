# Environment variables must be loaded by your shell (this file is not loaded automatically).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_API_KEY=
# Full HTTPS chat-completions compatible endpoint; keys stay in backend only.
LLM_API_URL=
LLM_MODEL=

# Set an administrator access key on the backend.
ADMIN_TOKEN=
# Empty for local SQLite. Use the provisioned PostgreSQL database on Vercel.
TRAIL_DATABASE_URL=
# Set to 1 for the existing HYUNDO Master seaguard schema.
SEAGUARD_PRIVATE_SCHEMA=
